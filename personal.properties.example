## Personal settings for Moyna. Copy this file to "personal.properties" and edit it.
## personal.properties is private and never uploaded (see .gitignore).

## Who Moyna suggests contacting for health questions and emergencies,
## written the way you'd say it in English, e.g. "her son", "her daughter Rina", "a family member".
CARE_CONTACT=a family member

## Emergency phone number where she lives (911 in the US/Canada, 999 in Bangladesh/UK, 112 in the EU).
EMERGENCY_NUMBER=911

## 4-digit PIN for the hidden admin screen (hold the clock for 10 seconds).
## Leave empty and the admin screen stays closed.
ADMIN_PIN=

## Buses for the bus tile (MTA Bus Time, New York), spoken in this order: LINE:stopcode,LINE:stopcode
## Find stop codes at bustime.mta.info. Needs MTA_BUSTIME_KEY=... in local.properties (free key).
BUS_STOPS=

## Home location for the weather strip (decimal degrees). Leave empty to switch weather off.
HOME_LAT=
HOME_LON=

## Optional: TP-Link Kasa smart plugs shown as on/off buttons on the hub.
## English name|Bengali name|plug's IP address, comma-separated. Put your Kasa app login in
## private/kasa-login.properties (KASA_EMAIL=..., KASA_PASSWORD=...). Leave empty for no light buttons.
LIGHTS=
